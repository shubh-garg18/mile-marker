# Copy to .env. Everything VITE_-prefixed is compiled into the public bundle,
# which is exactly why the OpenRouteService key is not here and never will be.

# Local Django dev server:
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production (Vercel env var) points at the Render service:
# VITE_API_BASE_URL=https://your-service.onrender.com
