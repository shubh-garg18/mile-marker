# Copy to .env and fill in. Never commit .env.

# Required in production. If unset, a random key is generated per process, which
# is safe here only because the service is stateless: no sessions, no auth,
# nothing signed. Generate a stable one for any real deployment:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# Leave False anywhere that is not your laptop.
DEBUG=True

# OpenRouteService key: https://openrouteservice.org/dev/#/signup
# Server-side only. This must never appear in the frontend bundle.
ORS_API_KEY=

# Comma-separated exact origins. Never a wildcard.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated. Render's own hostname is appended automatically.
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Optional tuning ---
# The home terminal's time zone. Sets the default departure date and is displayed
# in the trip summary. No time is converted against it, since §395.8(a) requires
# one time standard for the whole trip.
# HOME_TERMINAL_TIMEZONE=America/Chicago

# Seconds before a single OpenRouteService call is abandoned. A plan makes four
# required calls in sequence and each is allowed one retry, so the worst-case
# request is about 4 x (2 x this + backoff). Keep that under the web server's own
# timeout; see the deployment section of the README.
# ORS_TIMEOUT_SECONDS=15

# Throttle rate for anonymous clients. One plan can spend up to twenty upstream
# calls, and the ORS free tier allows forty a minute in total.
# PLAN_RATE_LIMIT=12/min

# --- Optional: RODS header placeholders (the brief supplies no carrier data) ---
# LOG_DRIVER_NAME=Shubh Garg
# LOG_CARRIER_NAME=Spotter Freight Lines, LLC
# LOG_OFFICE_ADDRESS=1400 Corridor Way, Fort Worth, TX 76106
# LOG_TERMINAL_ADDRESS=1400 Corridor Way, Fort Worth, TX 76106
# LOG_TRACTOR_NUMBER=4417
# LOG_TRAILER_NUMBER=2290
# LOG_SHIPPING_DOCUMENT=BOL 88-4417
# LOG_SHIPPER_COMMODITY=General freight, palletized
